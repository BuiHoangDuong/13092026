generator client {
  provider = "prisma-client-js"
  output   = "../dist/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PublishStatus {
  DRAFT
  PUBLISHED
}

enum ReportType {
  TRANSACTION
  AGGREGATE
}

enum IngestDatasetKind {
  REFERRAL_ACTIVITY
  COMMISSION
}

enum IngestSourceMethod {
  NATIVE_FILE
  NORMALIZED_FILE
  OFFICIAL_API
}

enum BatchStatus {
  UPLOADED
  PARSING
  PREVIEW
  COMMITTING
  PUBLISHED
  FAILED
}

enum WalletEntryType {
  CREDIT
  HOLD_RELEASE
  WITHDRAWAL_RESERVE
  WITHDRAWAL_RELEASE
  WITHDRAWAL_SETTLE
  ADJUSTMENT
  REVERSAL
  CLAWBACK
}

enum WithdrawalStatus {
  REQUESTED
  AUTO_APPROVED
  UNDER_REVIEW
  APPROVED
  PAID
  REJECTED
  CANCELLED
}

enum ActorType {
  CLAIMANT
  ADMIN
  SYSTEM
}

enum JobType {
  PARSE
  LOAD
  TRANSFORM
  PUBLISH
  ATTRIBUTE
  RELEASE_HOLDS
  SYNC
  SYNC_PAYABLES
  PAYOUT_SLOT
  PAYOUT_RECONCILE
  PAYABLE_COMMAND
}

enum RawLoadState {
  LOADED
  TRANSFORMED
  FAILED
  SUPERSEDED
}

enum JobState {
  PENDING
  CLAIMED
  DONE
  FAILED
}

enum ActivityMetricKind {
  TRADE_VOLUME
  TAKER_VOLUME
  MAKER_VOLUME
  TRADFI_VOLUME
  REPORTED_COMMISSION
}

enum MetricValueState {
  VALUE
  EMPTY
  ABSENT
}

enum ActivityDayState {
  OPEN
  SETTLING
  SEALED
  QUARANTINED
}

enum RosterState {
  ACTIVE
  GONE
}

enum SyncTrigger {
  SCHEDULED
  MANUAL
  BACKFILL
  RECONCILE
  RESYNC
}

enum SyncRunState {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  QUARANTINED
  PAUSED
}

enum SyncAuditAction {
  PAUSE
  UPDATE_CONFIG
  RUN_NOW
  RESUME
  RESYNC_RANGE
  RELEASE_OVERRIDE
}

model Exchange {
  id                  String              @id @default(cuid())
  slug                String              @unique
  name                String
  logoUrl             String? // Root-relative path to a repo asset in /exchange-logos/.
  status              PublishStatus       @default(DRAFT)
  defaultCashbackRate Decimal?            @db.Decimal(6, 4)
  i18n                Json?
  uidAccounts         UidAccount[]
  offers              Offer[]
  links               ReferralLink[]
  guides              Guide[]
  syncConfig          ExchangeSyncConfig?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
}

model Offer {
  id           String         @id @default(cuid())
  seedKey      String?        @unique
  exchangeId   String
  exchange     Exchange       @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  status       PublishStatus  @default(DRAFT)
  cashbackRate Decimal        @db.Decimal(6, 4)
  estimatedVolumeRate Decimal? @db.Decimal(12, 10)
  conditions   Json?
  verifiedAt   DateTime?
  i18n         Json?
  links        ReferralLink[]

  @@unique([id, exchangeId])
  @@index([exchangeId, status])
}

model ReferralLink {
  id          String       @id @default(cuid())
  seedKey     String?      @unique
  exchangeId  String
  exchange    Exchange     @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  offerId     String?
  offer       Offer?       @relation(fields: [offerId, exchangeId], references: [id, exchangeId], onDelete: Restrict)
  destination String
  active      Boolean      @default(true)
  clicks      ClickEvent[]

  @@index([exchangeId, active])
}

model Guide {
  id         String        @id @default(cuid())
  slug       String        @unique
  exchangeId String?
  exchange   Exchange?     @relation(fields: [exchangeId], references: [id], onDelete: SetNull)
  status     PublishStatus @default(DRAFT)
  i18n       Json?
}

model ClickEvent {
  id        String       @id @default(cuid())
  linkId    String
  link      ReferralLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@index([linkId, createdAt])
}

model AdminAccount {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String?
  sessions     Session[]
  createdAt    DateTime  @default(now())
}

model UidAccount {
  id               String             @id @default(cuid())
  exchangeId       String
  exchange         Exchange           @relation(fields: [exchangeId], references: [id], onDelete: Restrict)
  uid              String
  boundEmail       String?
  emailBoundAt     DateTime?
  wallets          Wallet[]
  withdrawals      Withdrawal[]
  otps             EmailOtp[]
  sessions         UidSession[]
  commissions      CommissionRecord[]
  payables         CustomerPayable[]
  payoutExecutions PayoutExecution[]
  createdAt        DateTime           @default(now())

  @@unique([exchangeId, uid])
  @@index([boundEmail])
}

model EmailOtp {
  id                String     @id @default(cuid())
  uidAccountId      String
  uidAccount        UidAccount @relation(fields: [uidAccountId], references: [id], onDelete: Restrict)
  email             String
  codeHash          String
  expiresAt         DateTime
  consumedAt        DateTime?
  failedAttempts    Int        @default(0)
  providerAccepted  Boolean    @default(false)
  providerMessageId String?
  createdAt         DateTime   @default(now())

  @@index([uidAccountId, createdAt])
  @@index([expiresAt])
}

model UidSession {
  id           String     @id @default(cuid())
  uidAccountId String
  uidAccount   UidAccount @relation(fields: [uidAccountId], references: [id], onDelete: Restrict)
  tokenHash    String     @unique
  expiresAt    DateTime
  createdAt    DateTime   @default(now())

  @@index([uidAccountId])
}

model RateLimitCounter {
  id          String   @id @default(cuid())
  scope       String
  subjectHash String
  windowStart DateTime
  count       Int      @default(0)

  @@unique([scope, subjectHash, windowStart])
  @@index([windowStart])
}

model Session {
  id        String       @id @default(cuid())
  adminId   String
  admin     AdminAccount @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash String       @unique
  expiresAt DateTime
  createdAt DateTime     @default(now())

  @@index([adminId])
}

model ImportBatch {
  id                String              @id @default(cuid())
  exchangeId        String
  rootAccount       String
  datasetKind       IngestDatasetKind
  sourceMethod      IngestSourceMethod
  reportType        ReportType?
  periodStart       DateTime
  periodEnd         DateTime
  sourceTz          String
  sourceAsOf        DateTime?
  fileRef           String
  originalFile      Bytes?
  publishedAt       DateTime?
  status            BatchStatus         @default(UPLOADED)
  totals            Json?
  schemaFingerprint String?
  adapterId         String?
  contractVersion   String?
  driftReport       Json?
  createdAt         DateTime            @default(now())
  rows              StagingRow[]
  versions          CommissionVersion[]
  snapshots         ReferralSnapshot[]
  rawLoads          RawLoad[]

  @@index([exchangeId, createdAt])
  @@index([exchangeId, datasetKind, status, periodEnd])
}

model RawLoad {
  id                String              @id @default(cuid())
  exchangeId        String
  sourceSystem      String
  datasetKind       IngestDatasetKind
  sourceMethod      IngestSourceMethod
  rootAccount       String
  periodStart       DateTime
  periodEnd         DateTime
  batchId           String?
  batch             ImportBatch?        @relation(fields: [batchId], references: [id])
  runId             String?
  state             RawLoadState        @default(LOADED)
  rowCount          Int
  fieldNames        Json
  schemaFingerprint String
  sourceMetadata    Json?
  driftReport       Json?
  safeErrorCode     String?
  loadedAt          DateTime            @default(now())
  transformedAt     DateTime?
  audits            RawTransformAudit[]

  @@index([exchangeId, datasetKind, sourceMethod, rootAccount, periodStart, periodEnd])
  @@index([state, loadedAt])
  @@index([batchId])
  @@index([runId])
}

model RawTransformAudit {
  id        String   @id @default(cuid())
  loadId    String
  load      RawLoad  @relation(fields: [loadId], references: [id])
  adminId   String
  createdAt DateTime @default(now())

  @@index([loadId, createdAt])
}

model StagingRow {
  id         String      @id @default(cuid())
  batchId    String
  batch      ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  raw        Json
  normalized Json?
  flags      Json?

  @@index([batchId])
}

/// Period referral metrics. Not payable commission and not a wallet balance.
model ReferralSnapshot {
  id               String           @id @default(cuid())
  batchId          String
  batch            ImportBatch      @relation(fields: [batchId], references: [id], onDelete: Restrict)
  exchangeId       String
  rootAccount      String
  uid              String
  periodStart      DateTime
  periodEnd        DateTime
  tradingVolume    Decimal          @db.Decimal(30, 10)
  tradingAsset     String
  reportedEarnings Decimal          @db.Decimal(30, 10)
  earningsAsset    String
  referralCode     String?
  partial          Boolean          @default(false)
  current          Boolean          @default(true)
  importedAt       DateTime         @default(now())
  metrics          ReferralMetric[]
  // One current row per (exchange, root, uid, exact period) is a partial unique
  // index WHERE current = true, added in SQL because Prisma cannot declare it.

  @@unique([batchId, uid])
  @@index([exchangeId, rootAccount, periodStart, periodEnd, current])
  @@index([exchangeId, uid, periodEnd])
}

/// Manual snapshot metrics. API sync uses ActivityMetricCurrent instead.
model ReferralMetric {
  id         String             @id @default(cuid())
  snapshotId String
  snapshot   ReferralSnapshot   @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  kind       ActivityMetricKind
  asset      String
  valueState MetricValueState
  amount     Decimal?           @db.Decimal(30, 10)

  @@unique([snapshotId, kind, asset])
}

model ExchangeSyncConfig {
  exchangeId            String    @id
  exchange              Exchange  @relation(fields: [exchangeId], references: [id], onDelete: Restrict)
  rootAccount           String
  enabled               Boolean   @default(false)
  adminPaused           Boolean   @default(false)
  intervalMinutes       Int       @default(30)
  backfillDays          Int       @default(365)
  nextRunAt             DateTime?
  lastAttemptAt         DateTime?
  lastSuccessAt         DateTime?
  lastFetchedPeriodEnd  DateTime?
  consecutiveFailures   Int       @default(0)
  pausedReason          String?
  credentialsConfigured Boolean   @default(false)
  readinessReady        Boolean   @default(false)
  readinessReason       String?
  readinessCheckedAt    DateTime?
  readinessExpiresAt    DateTime?
  readinessIpWarning    Boolean   @default(false)
  updatedBy             String?
  updatedAt             DateTime  @updatedAt
}

model SyncRun {
  id              String       @id @default(cuid())
  exchangeId      String
  rootAccount     String
  trigger         SyncTrigger
  state           SyncRunState
  contractVersion String
  changedRows     Int          @default(0)
  driftReport     Json?
  checkpoint      Json?
  daysWritten     Json?
  safeErrorCode   String?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime     @default(now())

  @@index([exchangeId, createdAt])
}

model ActivityPeriodOverride {
  exchangeId    String
  rootAccount   String
  periodStart   DateTime
  periodEnd     DateTime
  manualBatchId String
  active        Boolean  @default(true)
  updatedBy     String
  updatedAt     DateTime @updatedAt

  @@id([exchangeId, rootAccount, periodStart, periodEnd])
}

model SyncConfigAudit {
  id         String          @id @default(cuid())
  exchangeId String
  adminId    String
  action     SyncAuditAction
  before     Json?
  after      Json?
  createdAt  DateTime        @default(now())

  @@index([exchangeId, createdAt])
}

model ActivityRoster {
  exchangeId   String
  rootAccount  String
  uid          String
  referralCode String?
  state        RosterState @default(ACTIVE)
  missedRuns   Int         @default(0)
  firstSeenAt  DateTime
  lastSeenAt   DateTime

  @@id([exchangeId, rootAccount, uid])
}

model ActivityPeriodStatus {
  exchangeId         String
  rootAccount        String
  periodDate         DateTime         @db.Date
  state              ActivityDayState
  contentDigest      String?
  schemaFingerprint  String?
  contractVersion    String
  rowCount           Int
  fetchedAt          DateTime?
  responseObservedAt DateTime?
  sourceAsOf         DateTime?
  lastCheckedAt      DateTime
  lastChangedRunId   String?

  @@id([exchangeId, rootAccount, periodDate])
}

model ActivityMetricCurrent {
  exchangeId       String
  rootAccount      String
  uid              String
  periodDate       DateTime           @db.Date
  kind             ActivityMetricKind
  asset            String
  valueState       MetricValueState
  amount           Decimal?           @db.Decimal(30, 10)
  lastChangedRunId String
  updatedAt        DateTime           @updatedAt

  @@id([exchangeId, rootAccount, uid, periodDate, kind, asset])
  @@index([exchangeId, rootAccount, periodDate])
}

model ActivityMetricChange {
  id          String             @id @default(cuid())
  runId       String
  exchangeId  String
  rootAccount String
  uid         String
  periodDate  DateTime           @db.Date
  kind        ActivityMetricKind
  asset       String
  oldState    MetricValueState?
  oldAmount   Decimal?           @db.Decimal(30, 10)
  newState    MetricValueState
  newAmount   Decimal?           @db.Decimal(30, 10)
  changedAt   DateTime           @default(now())

  @@index([exchangeId, rootAccount, periodDate])
  @@index([runId])
}

model SyncRateSlot {
  id            String   @id
  nextRequestAt DateTime @default(now())
}

model CommissionRecord {
  id                     String              @id @default(cuid())
  exchangeId             String
  uid                    String
  asset                  String
  dedupKey               String
  reportType             ReportType?
  rootAccount            String?
  periodStart            DateTime
  periodEnd              DateTime
  reconciledAmount       Decimal             @default(0) @db.Decimal(30, 10)
  activeVersionId        String?             @unique
  activeVersion          CommissionVersion?  @relation("active_version", fields: [activeVersionId], references: [id])
  attributedUidAccountId String?
  attributedUidAccount   UidAccount?         @relation(fields: [attributedUidAccountId], references: [id], onDelete: Restrict)
  offerId                String?
  cashbackRate           Decimal?            @db.Decimal(6, 4)
  creditedCashback       Decimal             @default(0) @db.Decimal(30, 10)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  versions               CommissionVersion[] @relation("record_versions")

  @@unique([exchangeId, dedupKey])
  @@index([exchangeId, uid])
}

model CommissionVersion {
  id             String            @id @default(cuid())
  commissionId   String
  commission     CommissionRecord  @relation("record_versions", fields: [commissionId], references: [id], onDelete: Cascade)
  batchId        String
  batch          ImportBatch       @relation(fields: [batchId], references: [id], onDelete: Restrict)
  amount         Decimal           @db.Decimal(30, 10)
  referralLinkId String?
  superseded     Boolean           @default(false)
  importedAt     DateTime          @default(now())
  activeFor      CommissionRecord? @relation("active_version")

  @@unique([commissionId, batchId])
  @@index([commissionId, importedAt])
}

model Wallet {
  id           String        @id @default(cuid())
  uidAccountId String
  uidAccount   UidAccount    @relation(fields: [uidAccountId], references: [id], onDelete: Restrict)
  asset        String
  pending      Decimal       @default(0) @db.Decimal(30, 10)
  available    Decimal       @default(0) @db.Decimal(30, 10)
  reserved     Decimal       @default(0) @db.Decimal(30, 10)
  withdrawn    Decimal       @default(0) @db.Decimal(30, 10)
  receivable   Decimal       @default(0) @db.Decimal(30, 10)
  entries      WalletEntry[]

  @@unique([uidAccountId, asset])
}

model WalletEntry {
  id               String           @id @default(cuid())
  walletId         String
  wallet           Wallet           @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type             WalletEntryType
  amount           Decimal          @db.Decimal(30, 10)
  sourceRef        String?
  opKey            String?          @unique
  availableAt      DateTime?
  remainingPending Decimal          @default(0) @db.Decimal(30, 10)
  balanceChanges   Json?
  createdAt        DateTime         @default(now())
  payable          CustomerPayable?

  @@index([walletId, createdAt])
}

model Withdrawal {
  email        String
  isFirst      Boolean           @default(false)
  id           String            @id @default(cuid())
  uidAccountId String
  uidAccount   UidAccount        @relation(fields: [uidAccountId], references: [id], onDelete: Restrict)
  asset        String
  amount       Decimal           @db.Decimal(30, 10)
  network      String
  address      String
  status       WithdrawalStatus  @default(REQUESTED)
  payoutRef    String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  events       WithdrawalEvent[]

  @@index([status])
  @@index([uidAccountId, createdAt])
}

model WithdrawalEvent {
  email        String?
  id           String            @id @default(cuid())
  withdrawalId String
  withdrawal   Withdrawal        @relation(fields: [withdrawalId], references: [id], onDelete: Cascade)
  fromStatus   WithdrawalStatus?
  toStatus     WithdrawalStatus
  actorType    ActorType
  actorId      String?
  note         String?
  reference    String?
  createdAt    DateTime          @default(now())

  @@index([withdrawalId, createdAt])
}

model Job {
  id          String    @id @default(cuid())
  type        JobType
  payload     Json
  state       JobState  @default(PENDING)
  attempts    Int       @default(0)
  runAfter    DateTime  @default(now())
  leaseUntil  DateTime?
  heartbeatAt DateTime?
  lockedBy    String?
  lastError   String?
  createdAt   DateTime  @default(now())

  @@index([state, runAfter])
}

model WorkerHeartbeat {
  id         String    @id
  startedAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  stoppedAt  DateTime?

  @@index([lastSeenAt])
}

// ---------- Customer payables ledger (Req 22; approved #34 release grain, #35 execution mapping) ----------
enum PaymentStatus {
  UNPAID
  PAID
}

enum AllocationState {
  ACTIVE
  RELEASED
  SETTLED
}

enum ExecutionState {
  AWAITING_APPROVAL
  READY
  DISPATCHING
  SUBMITTED
  UNKNOWN
  CONFIRMED
  FAILED_NOT_SENT
  INVALIDATED
  CANCELLED
}

enum SyncScopeState {
  SYNCED
  PENDING
  FAILED
}

enum MoneyFlowMode {
  LEGACY
  FROZEN
  PAYABLE_ONLY
}

enum SlotState {
  RUNNING
  DONE
  MISSED
  BLOCKED
}

enum CommandStatus {
  ACCEPTED
  DONE
  REJECTED
}

/// One payable per released cashback (WalletEntry HOLD_RELEASE). T = entitlement, S = settledAmount, R = activeAmount.
model CustomerPayable {
  id                   String              @id @default(cuid())
  uidAccountId         String
  uidAccount           UidAccount          @relation(fields: [uidAccountId], references: [id], onDelete: Restrict)
  exchangeId           String
  asset                String
  sourceReleaseEntryId String              @unique
  sourceRelease        WalletEntry         @relation(fields: [sourceReleaseEntryId], references: [id], onDelete: Restrict)
  entitlement          Decimal             @db.Decimal(30, 10)
  settledAmount        Decimal             @default(0) @db.Decimal(30, 10)
  activeAmount         Decimal             @default(0) @db.Decimal(30, 10)
  paymentStatus        PaymentStatus       @default(UNPAID)
  version              Int                 @default(1)
  releasedAt           DateTime
  closedAt             DateTime?
  paidAt               DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  allocations          PayableAllocation[]

  @@unique([uidAccountId, asset, sourceReleaseEntryId])
  @@index([uidAccountId, asset, releasedAt])
  @@index([paymentStatus, closedAt])
}

/// A payout execution: one logical internal USDT transfer to one UID. Legacy Withdrawal rows map via legacyWithdrawalId.
model PayoutExecution {
  id                  String              @id @default(cuid())
  uidAccountId        String
  uidAccount          UidAccount          @relation(fields: [uidAccountId], references: [id], onDelete: Restrict)
  exchangeId          String
  asset               String
  slotKey             String
  total               Decimal             @db.Decimal(30, 10)
  requiresApproval    Boolean
  state               ExecutionState
  version             Int                 @default(1)
  valuationMode       String
  policyVersion       String
  approvedBy          String?
  approvedAt          DateTime?
  approvedVersion     Int?
  approvedTotal       Decimal?            @db.Decimal(30, 10)
  earliestSendAt      DateTime
  blockers            Json                @default("[]")
  dispatchKey         String?             @unique
  sourceAccountId     String?
  snapshot            Json?
  providerRef         String?
  paidAmount          Decimal?            @db.Decimal(30, 10)
  feeAmount           Decimal?            @db.Decimal(30, 10)
  failureCode         String?
  previousExecutionId String?
  legacyWithdrawalId  String?             @unique
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  dispatchedAt        DateTime?
  confirmedAt         DateTime?
  allocations         PayableAllocation[]

  @@index([uidAccountId, asset, state])
  @@index([state, earliestSendAt])
  @@index([slotKey])
}

model PayableAllocation {
  id          String          @id @default(cuid())
  executionId String
  execution   PayoutExecution @relation(fields: [executionId], references: [id], onDelete: Restrict)
  payableId   String
  payable     CustomerPayable @relation(fields: [payableId], references: [id], onDelete: Restrict)
  amount      Decimal         @db.Decimal(30, 10)
  state       AllocationState @default(ACTIVE)
  createdAt   DateTime        @default(now())
  closedAt    DateTime?

  @@unique([executionId, payableId])
  @@index([payableId, state])
}

/// Append-only audit of payable/execution changes (Req 22.13). Never stores secrets.
model PayableEvent {
  id           String    @id @default(cuid())
  uidAccountId String
  executionId  String?
  payableId    String?
  kind         String
  actorType    ActorType
  actorId      String?
  detail       Json?
  createdAt    DateTime  @default(now())

  @@index([uidAccountId, createdAt])
  @@index([executionId, createdAt])
}

/// Sync checkpoint per (UID account, asset): source writers bump sourceVersion, SYNC_PAYABLES applies it (Req 22.17-22.18).
model PayableSyncScope {
  uidAccountId      String
  asset             String
  sourceVersion     Int            @default(0)
  appliedVersion    Int            @default(0)
  state             SyncScopeState @default(PENDING)
  pendingCorrection Boolean        @default(false)
  invariantError    String?
  lastError         String?
  lastAppliedAt     DateTime?
  updatedAt         DateTime       @updatedAt

  @@id([uidAccountId, asset])
  @@index([state])
}

/// One row per daily 23:00 UTC payout slot; manifest freezes the cutoff list (Req 22.30).
model PayoutSlot {
  slotKey    String    @id
  cutoffAt   DateTime
  state      SlotState @default(RUNNING)
  manifest   Json?
  summary    Json?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
}

model PayableCommand {
  id            String        @id @default(cuid())
  commandKey    String        @unique
  type          String
  executionId   String
  payloadDigest String
  actorId       String
  status        CommandStatus @default(ACCEPTED)
  result        Json?
  createdAt     DateTime      @default(now())
  finishedAt    DateTime?

  @@index([executionId, createdAt])
}

/// Single-row DB gate for the money-flow cutover (Req 22.24). Missing/unknown mode fails closed.
model MoneyFlowGate {
  id        Int           @id @default(1)
  mode      MoneyFlowMode @default(LEGACY)
  version   Int           @default(1)
  updatedBy String?
  updatedAt DateTime      @updatedAt
}
