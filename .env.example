DATABASE_URL=postgresql://cashback:cashback@localhost:5432/cashback?schema=public
APP_URL=http://localhost:3000
IMPORT_STORAGE_ENDPOINT=http://localhost:9000
IMPORT_STORAGE_BUCKET=affiliate-reports
IMPORT_STORAGE_ACCESS_KEY=minio
IMPORT_STORAGE_SECRET_KEY=change-me
IMPORT_STORAGE_LOCAL_DIR=../../infra/data/imports
IMPORT_MAX_BYTES=10485760
WORKER_POLL_SECONDS=10
# Bybit Affiliate credentials belong to the worker only. The web service reads
# the worker's safe readiness snapshot from Postgres.
BYBIT_AFFILIATE_API_KEY=
BYBIT_AFFILIATE_API_SECRET=
BYBIT_AFFILIATE_MASTER_UID=
# MEXC Affiliate credentials belong to the worker only. Use a Spot Account Read
# key on the affiliate root account; the older MEXC_API_* variables are unused here.
MEXC_AFFILIATE_API_KEY=
MEXC_AFFILIATE_API_SECRET=
MEXC_AFFILIATE_MASTER_UID=
# Binance GET-only Api-Agent / Link & Trade connector (no master UID required).
# Keep these read-only credentials on the worker only.
BINANCE_AFFILIATE_API_KEY=
BINANCE_AFFILIATE_API_SECRET=
# BingX Affiliate placeholders for a future worker connector (not implemented yet).
# Use read-only credentials from the affiliate/agent account.
BINGX_AFFILIATE_API_KEY=
BINGX_AFFILIATE_API_SECRET=
BINGX_AFFILIATE_MASTER_UID=
# Required to release cashback. Empty keeps credits pending; choose a value before enabling release.
HOLDING_PERIOD_HOURS=
# Explicit enabled asset/network routes, e.g. {"USDT":["TRON","ETHEREUM"]}. Empty disables requests.
WITHDRAWAL_ROUTES={}
# Per-asset decimal thresholds, e.g. {"USDT":"100"}; missing assets always require review.
WITHDRAWAL_AUTO_APPROVE_THRESHOLDS={}
JOB_LEASE_SECONDS=120
HEALTH_WORKER_STALE_SECONDS=60
HEALTH_OLDEST_JOB_ALERT_SECONDS=300
HEALTH_IMPORT_ERROR_RATE_ALERT=0.2
# Optional HTTPS endpoint for throttled operational alerts from the worker.
OPERATIONS_ALERT_WEBHOOK_URL=
LOOKUP_RATE_PER_MINUTE=5
LOOKUP_RATE_PER_HOUR=30
# Set only to a client IP header overwritten by your trusted reverse proxy.
# Production lookup/OTP fail closed without a valid IP; never trust arbitrary client headers.
CLIENT_IP_HEADER=
RESEND_API_KEY=
# A sender address on your verified Resend domain; resend.dev is rejected.
EMAIL_FROM=
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_SECONDS=60
OTP_DAILY_CAP=5
OTP_IP_PER_MINUTE=5
OTP_IP_PER_HOUR=30
OTP_VERIFY_IP_PER_MINUTE=30
SYNC_INTERVAL_MINUTES=0
SESSION_COOKIE_NAME=cashback_session
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
